DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/suhs?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3000
# Optional initial administrator, created by npm run db:seed.
ADMIN_EMAIL=admin@suhs.edu
ADMIN_NAME="System Admin"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Entra single-tenant Web app. Keep the secret on the backend only.
FRONTEND_URL=http://localhost:3001
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
