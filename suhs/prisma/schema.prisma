generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  microsoftId  String?  @unique
  role         Role     @default(STUDENT)
  subject      String?
  className    String?
  rollNumber   String?
  division     String?
  studentGroup String?
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
}
